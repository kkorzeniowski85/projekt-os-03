{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "fiszki-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "frontend",
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "fiszki-static",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "4173"],
      "cwd": "frontend/out",
      "port": 4173,
      "autoPort": true
    }
  ]
}
