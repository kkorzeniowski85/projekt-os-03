# Skopiuj do backend/.env i uzupelnij.

ENVIRONMENT=dev

# Docker Compose (domyslne):
DATABASE_URL=postgresql+psycopg://fiszki:fiszki@localhost:5432/fiszki
# Postgres zainstalowany natywnie - podmien uzytkownika/haslo/nazwe bazy:
# DATABASE_URL=postgresql+psycopg://postgres:TWOJE_HASLO@localhost:5432/fiszki

# Wygeneruj: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=zmien-mnie-przed-produkcja

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Bez tego kodu nikt sie nie zarejestruje.
INVITE_CODE=rodzina

CORS_ORIGINS=["http://localhost:3000"]

# Na produkcji (HTTPS) ustaw na true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

DAY_ROLLOVER_HOUR=4
